# 이 파일을 .env.local로 복사해서 값을 채우세요. (.env.local은 git에 올라가지 않아요)
#
# /api 요청을 보낼 백엔드 주소. 비워 두면 http://localhost:5000
#   - 같은 서버 공간에서 FastAPI를 5000으로 띄운 경우: 비워 두기
#   - 팀 API에 붙는 경우: http://<서버IP>:<팀 API 외부 포트>
API_PROXY_TARGET=

# 백엔드 없이 화면을 볼 때 true (개발 서버에서만 동작, src/mocks/mockApi.ts)
# 시나리오는 S1 주소에 낱말로 골라요: fail1 · fail2 · noclaims · nomap · verifyfail · private · error500 · cached · multi · clean
VITE_API_MOCK=false
